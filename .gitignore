# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# PyPI configuration file
.pypirc

# PyTorch (Lightning) large files
*.ckpt
*.pt

.DS_store

# =============================================================================
# DATASETS - Exclude heavy/original files, keep custom Python/CSV/metadata
# =============================================================================

# AudioSet_EV_v1_2025 - Exclude audio files, zip archives, and ALL CSV files
datasets/AudioSet_EV_v1_2025/*.zip
datasets/AudioSet_EV_v1_2025/Positive_files/
datasets/AudioSet_EV_v1_2025/Negative_files/
datasets/AudioSet_EV_v1_2025/*.csv

# AudioSet_EV_v2PANNs_2020 - Exclude audio files and ALL CSV files (root and audioset_metadata)
datasets/AudioSet_EV_v2PANNs_2020/Positive_files/
datasets/AudioSet_EV_v2PANNs_2020/Negative_files/
datasets/AudioSet_EV_v2PANNs_2020/*.csv
datasets/AudioSet_EV_v2PANNs_2020/audioset_metadata/*.csv

# ESC-50 - Exclude original contents
datasets/ESC-50/cross_val_folds/
datasets/ESC-50/original_audio/
datasets/ESC-50/esc50.csv
datasets/ESC-50/LICENSE
datasets/ESC-50/README.md

# FSD50K - Exclude original archives and audio folders
datasets/FSD50K/original_archive/
datasets/FSD50K/FSD50K.*/

# LSSiren - Exclude original contents
datasets/LSSiren/Ambulance_data/
datasets/LSSiren/Road_Noises/
datasets/LSSiren/*.csv

# sireNNet - Exclude category audio folders
datasets/sireNNet/ambulance/
datasets/sireNNet/firetruck/
datasets/sireNNet/police/
datasets/sireNNet/traffic/

# UrbanSound8K - Exclude all except Python files
datasets/UrbanSound8K/audio/
datasets/UrbanSound8K/metadata/
datasets/UrbanSound8K/FREESOUNDCREDITS.txt
datasets/UrbanSound8K/UrbanSound8K_README.txt
